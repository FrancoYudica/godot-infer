{
  "version": 5,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "GODOTCPP_TARGET": "template_debug",
        "BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "windows-msvc-debug",
      "displayName": "Windows (cl.exe, Debug)",
      "inherits": "base",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../build/windows-msvc-debug",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_BUILD_TYPE": "Debug",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static"
      }
    },
    {
      "name": "windows-msvc-debug-tests",
      "displayName": "Windows (cl.exe, Debug, with tests)",
      "inherits": "windows-msvc-debug",
      "binaryDir": "${sourceDir}/../build/windows-msvc-debug-tests",
      "cacheVariables": { "BUILD_TESTS": "ON" }
    },
    {
      "name": "windows-msvc-release",
      "displayName": "Windows (cl.exe, Release / shipping export)",
      "inherits": "windows-msvc-debug",
      "binaryDir": "${sourceDir}/../build/windows-msvc-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "GODOTCPP_TARGET": "template_release"
      }
    },
    {
      "name": "windows-msvc-release-tests",
      "displayName": "Windows (cl.exe, Release, with tests)",
      "inherits": "windows-msvc-release",
      "binaryDir": "${sourceDir}/../build/windows-msvc-release-tests",
      "cacheVariables": { "BUILD_TESTS": "ON" }
    },
    {
      "name": "linux-clang-debug",
      "displayName": "Linux (clang, Debug)",
      "inherits": "base",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../build/linux-clang-debug",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_BUILD_TYPE": "Debug",
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      }
    },
    {
      "name": "linux-clang-debug-tests",
      "displayName": "Linux (clang, Debug, with tests)",
      "inherits": "linux-clang-debug",
      "binaryDir": "${sourceDir}/../build/linux-clang-debug-tests",
      "cacheVariables": { "BUILD_TESTS": "ON" }
    },
    {
      "name": "linux-clang-release",
      "displayName": "Linux (clang, Release)",
      "inherits": "linux-clang-debug",
      "binaryDir": "${sourceDir}/../build/linux-clang-release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "linux-clang-release-tests",
      "displayName": "Linux (clang, Release, with tests)",
      "inherits": "linux-clang-release",
      "binaryDir": "${sourceDir}/../build/linux-clang-release-tests",
      "cacheVariables": { "BUILD_TESTS": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "windows-msvc-debug", "configurePreset": "windows-msvc-debug" },
    { "name": "windows-msvc-debug-tests", "configurePreset": "windows-msvc-debug-tests" },
    { "name": "windows-msvc-release", "configurePreset": "windows-msvc-release" },
    { "name": "windows-msvc-release-tests", "configurePreset": "windows-msvc-release-tests" },
    { "name": "linux-clang-debug", "configurePreset": "linux-clang-debug" },
    { "name": "linux-clang-debug-tests", "configurePreset": "linux-clang-debug-tests" },
    { "name": "linux-clang-release", "configurePreset": "linux-clang-release" },
    { "name": "linux-clang-release-tests", "configurePreset": "linux-clang-release-tests" }
  ],
  "testPresets": [
    { "name": "windows-msvc-debug-tests", "configurePreset": "windows-msvc-debug-tests", "output": { "outputOnFailure": true } },
    { "name": "windows-msvc-release-tests", "configurePreset": "windows-msvc-release-tests", "output": { "outputOnFailure": true } },
    { "name": "linux-clang-debug-tests", "configurePreset": "linux-clang-debug-tests", "output": { "outputOnFailure": true } },
    { "name": "linux-clang-release-tests", "configurePreset": "linux-clang-release-tests", "output": { "outputOnFailure": true } }
  ]
}
